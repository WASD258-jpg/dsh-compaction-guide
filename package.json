{
  "name": "dsh-compaction-guide-verification",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dependencies for reproducing the verification scripts in this repository. Not published; not needed to read the guide.",
  "comment": "The guide itself has no runtime dependencies. This file exists only so the verify-*/ scripts can be re-run by a reader. Versions are pinned to the revision the measurements were taken against. Install with pnpm: pnpm tolerates the peer-range defect described below, while npm refuses to install at all.",
  "files": [
    "guide",
    "tools",
    "config",
    "verify-refs",
    "verify-config",
    "verify-argszero",
    "verify-feasibility",
    "README.md",
    "README.zh.md",
    "EVIDENCE.md",
    "EVIDENCE.zh.md",
    "PRIOR-ART.md",
    "PRIOR-ART.zh.md",
    "PLAN.md",
    "PLAN.zh.md",
    "REFERENCES.md",
    "REFERENCES.zh.md",
    "REPRODUCING.md",
    "REPRODUCING.zh.md",
    "TRANSLATING.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-compaction-basic": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.2.0-rc.2"
  },
  "optionalDependencies": {
    "@argszero/cordis-plugin-length-stop-overflow": "0.3.0"
  },
  "scripts": {
    "verify:refs": "node verify-refs/check-refs.mjs",
    "verify:config": "node verify-config/schema-test2.mjs",
    "verify:risk": "node verify-config/risk-test.mjs",
    "verify:reachability": "node verify-config/pathb-final.mjs",
    "verify:argszero": "node verify-argszero/verify.mjs",
    "verify:privacy": "node tools/privacy-check.mjs ."
  }
}
